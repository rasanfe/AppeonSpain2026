<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FicharApi</RootNamespace>
    <AssemblyName>FicharDemoApi</AssemblyName>
    <!-- La demo viaja a otra maquina: se publica autocontenida en un solo .exe -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Los datos (Database/*.json) se leen y escriben en su sitio: que el
         build NO los copie a bin, o la API acabaria escribiendo en la copia -->
    <Content Remove="Database\**" />
    <None Include="Database\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Seguridad: lo que en 2024 NO estaba -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="9.0.6" />
  </ItemGroup>

</Project>
