# Copiar a .env y rellenar. El .env NUNCA se sube a git.
# No hay base de datos: los datos son JSON en FicharDemoApi/Database.

# Clave para firmar los JWT de la API demo (cualquier cadena larga)
DEMO_JWT_KEY=<pon-aqui-una-clave-larga-de-al-menos-32-caracteres>

# Puerto unico donde la API sirve tambien la web
DEMO_API_PORT=5080
