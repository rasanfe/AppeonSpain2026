Integer li_Count
window lw_Sheet

/* devuelve número de 'hojas' abiertas (hoja es ventana abierta con opensheet )*/
lw_Sheet = aw_main.GetFirstSheet ()

if IsValid (lw_Sheet) then
	Do
		li_Count += 1
		lw_Sheet = aw_main.GetNextSheet (lw_Sheet)
	Loop While IsValid (lw_Sheet)
end if

return li_count
end function

